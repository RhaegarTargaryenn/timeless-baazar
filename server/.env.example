# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Atlas → Connect → Drivers → Node.js. Replace <password> with the DB user's
# password, and put the database name before the "?" as shown.
MONGODB_URI=mongodb+srv://tb_api:<password>@timeless-baazar.xxxxx.mongodb.net/timeless_baazar?retryWrites=true&w=majority

# ── Firebase Admin ─────────────────────────────────────────────────────────
# Firebase Console → Project Settings → Service accounts → Generate new
# private key. Paste the WHOLE downloaded JSON here as ONE line, in quotes.
# Do not commit the .json file itself.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Who may edit products and coupons ──────────────────────────────────────
# Firebase UIDs, comma-separated. Find one in Firebase Console →
# Authentication → Users. Leave empty and nobody can write anything.
ADMIN_UIDS=

# ── Browsers allowed to call this API ──────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://timelessbazzar.netlify.app

# ── Google Sheets mirror ───────────────────────────────────────────────────
SHEETS_WEBAPP_URL=

PORT=4000
NODE_ENV=development
