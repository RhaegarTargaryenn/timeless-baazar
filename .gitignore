# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
frontend/build/

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
.env.*
!.env.example
# The deployed API URL is public (it is already in netlify.toml) and is NOT a
# secret. It lives in a committed .env.production so that EVERY production
# build gets it -- a local `npm run build`, a folder dragged into Netlify, or
# Netlify's own CI. Relying on netlify.toml's build.environment only works for
# the last of those.
!.env.production

# editor
.vscode/
.idea/

# Firebase service account private keys. These must never be committed --
# anyone holding one can mint admin tokens for the whole Firebase project.
*firebase-adminsdk*.json
*serviceAccount*.json
