# Firebase (Auth only from Phase 1 onward — Firestore leaves in Phase 4).
# These are public by design; Firebase security comes from rules, not secrecy.
# They still live here so dev and prod can point at different projects.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Apps Script endpoint that mirrors orders into the client's Sheet.
# Phase 4 moves this call to the backend; until then the browser posts to it.
VITE_SHEETS_WEBAPP_URL=
